<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Reference plugin for proper architecture -->
    <ProjectReference Include="..\src\Tidalarr\Tidalarr.csproj" />
    <ProjectReference Include="..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Allow unused code in CLI test/mock implementations -->
    <NoWarn>$(NoWarn);IDE0052;IDE0060</NoWarn>
    <!-- CLI project always needs CLI framework -->
    <IncludeCLIFramework>true</IncludeCLIFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>

