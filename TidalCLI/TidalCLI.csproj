<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Reference plugin for proper architecture -->
    <ProjectReference Include="..\src\Tidalarr\Tidalarr.csproj" />
    <ProjectReference Include="..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CLI project always needs CLI framework -->
    <IncludeCLIFramework>true</IncludeCLIFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>

