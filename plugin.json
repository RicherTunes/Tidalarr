{
  "id": "tidalarr",
  "name": "Tidalarr",
  "version": "1.0.1",
  "apiVersion": "1.x",
  "commonVersion": "1.2.2",
  "minHostVersion": "2.14.2.4786",
  "minimumVersion": "2.14.2.4786",
  "entryAssembly": "Lidarr.Plugin.Tidalarr.dll",
  "description": "Tidal integration for Lidarr - Search and download music from Tidal",
  "author": "RicherTunes",
  "homepage": "https://github.com/RicherTunes/Tidalarr",
  "license": "MIT",
  "capabilities": [
    "Search",
    "Download",
    "OAuth"
  ],
  "requiredSettings": [
    "ConfigPath",
    "RedirectUrl",
    "DownloadPath"
  ],
  "protocols": [
    "Tidalarr.TidalProtocol"
  ],
  "features": [
    "OAuth 2.0 PKCE Authentication",
    "High Quality Audio (Lossless, Hi-Res)",
    "Smart Quality Detection",
    "Sequential Chunk Downloading",
    "Manifest Parsing (DASH/BTS)",
    "Error Recovery"
  ]
}
