<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress analyzer warnings from Common library submodule -->
    <!-- RS0025: PublicAPI duplicate entries in submodule - not our concern -->
    <NoWarn>$(NoWarn);RS0025</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tidalarr\Tidalarr.csproj" />
    <!-- HostBridge requires Lidarr assemblies - excluded in CI with ExcludeHostBridge=true -->
    <ProjectReference Include="..\..\src\Tidalarr.HostBridge\Tidalarr.HostBridge.csproj" Condition="'$(ExcludeHostBridge)' != 'true'" />

    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj">
      <!-- Disable analyzers on submodule to avoid PublicAPI warnings in CI -->
      <AdditionalProperties>RunAnalyzersDuringBuild=false;EnableNETAnalyzers=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Abstractions\Lidarr.Plugin.Abstractions.csproj">
      <AdditionalProperties>RunAnalyzersDuringBuild=false;EnableNETAnalyzers=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <!-- Lidarr assemblies only needed when HostBridge is included -->
  <ItemGroup Condition="'$(ExcludeHostBridge)' != 'true'">
    <Reference Include="Lidarr.Core">
      <HintPath>..\..\ext\Lidarr\_output\net6.0\Lidarr.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lidarr.Common">
      <HintPath>..\..\ext\Lidarr\_output\net6.0\Lidarr.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures\sample_tone.m4a" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <!-- Exclude HostBridge-dependent test files when HostBridge is excluded -->
  <ItemGroup Condition="'$(ExcludeHostBridge)' == 'true'">
    <Compile Remove="Unit\HostBridgeMappingTests.cs" />
    <Compile Remove="Unit\TidalProtocolTests.cs" />
    <!-- Exclude ALL Tidal* integration tests - they use outdated DTO/model patterns -->
    <Compile Remove="Tidal*.cs" />
    <!-- Keep only architecture, compliance, and infrastructure tests -->
  </ItemGroup>
</Project>
