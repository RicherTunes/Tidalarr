<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Allow unused code and runtime regex in test fixtures -->
    <NoWarn>$(NoWarn);IDE0052;IDE0060;SYSLIB1045</NoWarn>
    <!-- Suppress analyzer warnings from Common library submodule -->
    <!-- RS0025: PublicAPI duplicate entries in submodule - not our concern -->
    <NoWarn>$(NoWarn);RS0025</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ExcludeHostBridge)' == 'true'">
    <DefineConstants>$(DefineConstants);EXCLUDE_HOST_BRIDGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="coverlet.msbuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- NLog runtime needed for tests that exercise NLog-using types.
         Tidalarr.csproj excludes NLog runtime assets (ILRepack internalizes it), so tests need their own copy. -->
    <PackageReference Include="NLog" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- OutputPath redirect: keep the test-only un-merged plugin DLL out of the repo /bin/
         folder so test runs don't clobber the merged (production) DLL that Lidarr loads.
         PluginPackagingDisable=true skips the ILRepack step entirely so the assembly retains
         its standalone Lidarr.Plugin.Common + Lidarr.Plugin.Abstractions type identity —
         tests can pass live instances of those types across the boundary without hitting
         the cross-ALC MissingMethodException that the merged DLL triggers.
         Mirrors qobuzarr's pattern at tests/Qobuzarr.Tests/Qobuzarr.Tests.csproj. -->
    <ProjectReference Include="..\..\src\Tidalarr\Tidalarr.csproj">
      <AdditionalProperties>PluginPackagingDisable=true;OutputPath=bin-tests\;EnablePluginDeployment=false</AdditionalProperties>
    </ProjectReference>
    <!-- HostBridge requires Lidarr assemblies - excluded in CI with ExcludeHostBridge=true -->
    <ProjectReference Include="..\..\src\Tidalarr.HostBridge\Tidalarr.HostBridge.csproj" Condition="'$(ExcludeHostBridge)' != 'true'" />

    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj">
      <!-- Disable analyzers on submodule to avoid PublicAPI warnings in CI -->
      <AdditionalProperties>RunAnalyzersDuringBuild=false;EnableNETAnalyzers=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Abstractions\Lidarr.Plugin.Abstractions.csproj">
      <AdditionalProperties>RunAnalyzersDuringBuild=false;EnableNETAnalyzers=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\testkit\Lidarr.Plugin.Common.TestKit.csproj" />
  </ItemGroup>
  <!-- FluentValidation is needed by TidalModule.RegisterServices even when
       HostBridge-specific tests are excluded from the hermetic CI gate. -->
  <ItemGroup>
    <Reference Include="FluentValidation" Condition="Exists('..\..\ext\Lidarr\_output\net8.0\FluentValidation.dll')">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\FluentValidation.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- Lidarr assemblies only needed when HostBridge is included -->
  <ItemGroup Condition="'$(ExcludeHostBridge)' != 'true'">
    <Reference Include="Lidarr.Core">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\Lidarr.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lidarr.Common">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\Lidarr.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures\sample_tone.m4a" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <!-- Exclude test files that use outdated patterns or platform-specific tests in CI (ExcludeHostBridge=true) -->
  <ItemGroup Condition="'$(ExcludeHostBridge)' == 'true'">
    <!-- HostBridge tests require full Lidarr assemblies -->
    <Compile Remove="Unit\HostBridgeMappingTests.cs" />
    <Compile Remove="Unit\TidalDownloadClientHostSettingsParityTests.cs" />
    <Compile Remove="Unit\TidalQualityEnumParityTests.cs" />
    <Compile Remove="Unit\TidalProtocolTests.cs" />
    <!-- Lidarr-native types (ReleaseInfo, DownloadItemStatus) require Lidarr.Core -->
    <Compile Remove="Integration\TidalRuntimeCacheTests.cs" />
    <Compile Remove="Unit\TidalLidarrDownloadClientGuidParsingTests.cs" />
    <Compile Remove="Unit\TidalLidarrDownloadClientSettingsTests.cs" />
    <Compile Remove="Unit\TidalLidarrDownloadClientSnapshotTests.cs" />
    <Compile Remove="Unit\TidalLidarrDownloadClientGetItemsTests.cs" />
    <Compile Remove="Unit\LidarrNative\TidalLidarrParserProtocolTests.cs" />
    <!-- Favorites import list tests reference NzbDrone.Core.ImportLists (host) — excluded in host-free CI.
         Subfolder path is not caught by the root-level Tidal*.cs remove, so remove it explicitly. -->
    <Compile Remove="Unit\LidarrNative\TidalFavoritesImportListTests.cs" />
    <!-- Exclude Unit/* diagnostics tests that use IReadOnlyList patterns -->
    <Compile Remove="Unit\IndexerDiagnosticsTests.cs" />
    <Compile Remove="Unit\DownloadValidationDiagnosticsTests.cs" />
    <!-- TidalLidarrParser returns ReleaseInfo from Lidarr.Core -->
    <Compile Remove="Unit\TidalLidarrIndexerSizeEstimationTests.cs" />
    <Compile Remove="Unit\LidarrNative\TidalLidarrIndexerOAuthStateExchangeTests.cs" />
    <!-- Exclude ALL Tidal* integration tests - use outdated DTO/model patterns -->
    <Compile Remove="Tidal*.cs" />
    <!-- Host-free OAuth hermetic tests (only Lidarr.Plugin.Common refs, no NzbDrone.Core) MUST be
         re-included after the broad Tidal*.cs remove so they actually gate under ExcludeHostBridge=true CI.
         HermeticTestGatingGuard fails if any TidalOAuthService*Tests.cs source file is missing here. -->
    <Compile Include="TidalOAuthServiceTests.cs" />
    <Compile Include="TidalOAuthServiceStorageTests.cs" />
    <Compile Include="TidalOAuthServiceLogoutTests.cs" />
    <Compile Include="TidalOAuthServiceTokenLifecycleTests.cs" />
    <Compile Include="TidalOAuthServiceRevokedRefreshTokenTests.cs" />
    <Compile Include="TidalOAuthServiceCrossInstanceRotationTests.cs" />
    <Compile Include="TidalOAuthServiceMissingRefreshTokenTests.cs" />
    <Compile Include="TidalOAuthServiceRefreshTokenCarryForwardTests.cs" />
    <Compile Include="TidalTestPolicies.cs" />
    <!-- TidalModelMapperTests.cs only references Lidarr.Plugin.Abstractions.Models + Tidalarr.Core
         (no NzbDrone/HostBridge types) — swept up by the broad Tidal*.cs remove above with no
         legitimate reason to stay excluded. It silently failed on main (2026-07-01) with nobody
         noticing because CI never compiled it; re-included so the hermetic gate actually runs it. -->
    <Compile Include="TidalModelMapperTests.cs" />
    <!-- Host-free pagination tests (codex PR #56) — re-included after the broad Tidal*.cs remove. -->
    <Compile Include="TidalApiClientPaginationTests.cs" />
    <!-- Host-free favorites-import-list API tests (feat B4) — re-included after the broad Tidal*.cs remove. -->
    <Compile Include="TidalApiClientFavoritesTests.cs" />
    <!-- Integration tests that reference FluentValidation.Results -->
    <Compile Remove="SilverMedalIntegrationTests.cs" />
    <Compile Remove="EndToEndIntegrationTests.cs" />
    <!-- Exclude milestone tests that reference MockTokenStorage -->
    <Compile Remove="Week1MilestoneTests.cs" />
    <Compile Remove="*MilestoneTests.cs" />
    <!-- Path validation tests have platform-specific expectations that fail on Linux CI -->
    <Compile Remove="Unit\PathValidationExtensionsTests.cs" />
    <!-- Exclude plugin smoke tests that look for Debug build output -->
    <Compile Remove="PluginSmokeTests.cs" />
    <!-- Compliance\TidalDownloadClientHostContractTests.cs genuinely needs NzbDrone.Core.Download +
         Lidarr.Plugin.Common.HostBridge. TidalarrPluginComplianceTests.cs and
         TidalarrStreamingComplianceTests.cs also reflect the FULL plugin assembly
         (Assembly.GetTypes()), which transitively requires Lidarr.Core.dll to be loadable even
         though neither file directly `using`s a NzbDrone/HostBridge type — verified by actually
         building+running under ExcludeHostBridge=true (15 ReflectionTypeLoadException failures),
         not assumed from a `using` scan. All three stay excluded here.
         TidalarrSecurityComplianceTests.cs is re-included below: it's hermetic-safe (source-file
         regex scans) except for one test with the same GetTypes() problem, fixed alongside this
         re-include so the file as a whole is genuinely host-free. -->
    <Compile Remove="Compliance\*.cs" />
    <!-- Forward slash (portable): keeps HermeticTestGatingGuard's Path.GetFileName parse correct on
         Linux CI, where '\' is not a path separator. -->
    <Compile Include="Compliance/TidalarrSecurityComplianceTests.cs" />
    <!-- Exclude token storage tests with platform-specific path behavior -->
    <Compile Remove="JsonTokenStorageTests.cs" />
    <!-- IndexerCovTests uses Moq + FluentValidation.Results — both require Lidarr assemblies -->
    <Compile Remove="IndexerCovTests.cs" />
    <!-- TidalLidarrParserParseResponseTests uses NzbDrone types from Lidarr.Core -->
    <Compile Remove="Unit\LidarrNative\TidalLidarrParserParseResponseTests.cs" />
    <!-- TidalLidarrIndexerSettingsValidatorTests calls AbstractValidator.Validate() from FluentValidation.dll -->
    <Compile Remove="Unit\LidarrNative\TidalLidarrIndexerSettingsValidatorTests.cs" />
    <!-- DeadSettingsGuardTests reflects over TidalLidarrIndexerSettings/TidalLidarrDownloadClientSettings,
         which use NzbDrone.Core.Annotations.FieldDefinitionAttribute (requires Lidarr.Core.dll). -->
    <Compile Remove="Documentation\DeadSettingsGuardTests.cs" />
  </ItemGroup>
</Project>
