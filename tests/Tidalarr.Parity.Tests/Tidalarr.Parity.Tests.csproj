<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
    <!-- This project opts out of CPM (ManagePackageVersionsCentrally=false), so the central
         System.Security.Cryptography.Xml pin does not apply here; the vulnerable 8.0.3 flows
         transitively from the Common submodule's direct floor (via the TestKit reference) and
         the CI CVE gate scans the whole solution. Direct reference mirrors the central 8.0.4
         pin (2026-07 advisory wave) — drop once the Common submodule repin (>= 8.0.4 floor)
         lands. Same pattern as qobuzarr's Parity.Tests. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\testkit\Lidarr.Plugin.Common.TestKit.csproj" />
    <!-- Wave 10: needed so behavior-contract checks can reflect over the plugin assembly. -->
    <ProjectReference Include="..\..\src\Tidalarr\Tidalarr.csproj">
      <AdditionalProperties>PluginPackagingDisable=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
