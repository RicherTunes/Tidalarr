<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tidalarr.HostBridge</AssemblyName>
    <RootNamespace>Tidalarr</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Lidarr.Core">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\Lidarr.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lidarr.Common">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\Lidarr.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Host's FluentValidation 9.x - needed for NzbDroneValidationResult construction.
         Must use host's assembly (not NuGet FV 11) to avoid type mismatch at runtime. -->
    <Reference Include="FluentValidation">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\FluentValidation.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tidalarr\Tidalarr.csproj" />
  </ItemGroup>
</Project>

