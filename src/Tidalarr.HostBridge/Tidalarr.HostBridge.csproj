<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tidalarr.HostBridge</AssemblyName>
    <RootNamespace>Tidalarr</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Resolve LidarrPath from env and common extraction locations -->
  <PropertyGroup>
    <LidarrPath Condition="'$(LidarrPath)' == ''">$(LIDARR_PATH)</LidarrPath>
    <!-- Docker extraction paths (CI) -->
    <LidarrPath Condition="'$(LidarrPath)' == '' AND Exists('..\..\ext\Lidarr-docker\_output\net6.0')">..\..\ext\Lidarr-docker\_output\net6.0</LidarrPath>
    <LidarrPath Condition="'$(LidarrPath)' == '' AND Exists('..\..\ext\Lidarr-docker\_output\net8.0')">..\..\ext\Lidarr-docker\_output\net8.0</LidarrPath>
    <!-- Local submodule paths -->
    <LidarrPath Condition="'$(LidarrPath)' == '' AND Exists('..\..\ext\Lidarr\_output\net6.0')">..\..\ext\Lidarr\_output\net6.0</LidarrPath>
    <LidarrPath Condition="'$(LidarrPath)' == '' AND Exists('..\..\ext\Lidarr\_output\net8.0')">..\..\ext\Lidarr\_output\net8.0</LidarrPath>
    <!-- System install paths -->
    <LidarrPath Condition="'$(LidarrPath)' == '' AND Exists('C:\ProgramData\Lidarr\bin')">C:\ProgramData\Lidarr\bin</LidarrPath>
    <LidarrPath Condition="'$(LidarrPath)' == '' AND Exists('/opt/Lidarr')">/opt/Lidarr</LidarrPath>
    <LidarrPath Condition="'$(LidarrPath)' == '' AND Exists('/usr/lib/lidarr/bin')">/usr/lib/lidarr/bin</LidarrPath>
  </PropertyGroup>

  <!-- CI fallback path using MSBuildThisFileDirectory for predictable resolution -->
  <PropertyGroup Condition="'$(CI)' == 'true' and '$(LidarrPath)' == ''">
    <LidarrPath Condition="Exists('$(MSBuildThisFileDirectory)..\..\ext\Lidarr-docker\_output\net6.0')">$(MSBuildThisFileDirectory)..\..\ext\Lidarr-docker\_output\net6.0</LidarrPath>
    <LidarrPath Condition="'$(LidarrPath)' == ''">$(MSBuildThisFileDirectory)..\..\ext\Lidarr-docker\_output\net8.0</LidarrPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(LidarrPath)' != ''">
    <Reference Include="Lidarr.Core">
      <HintPath>$(LidarrPath)\Lidarr.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lidarr.Common">
      <HintPath>$(LidarrPath)\Lidarr.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tidalarr\Tidalarr.csproj" />
  </ItemGroup>

  <Target Name="ValidateLidarrPath" BeforeTargets="Build">
    <Warning Condition="'$(LidarrPath)' == ''" Text="Lidarr installation not found. Set LIDARR_PATH environment variable or ensure ext/Lidarr assemblies exist." />
    <Message Condition="'$(LidarrPath)' != ''" Text="HostBridge using Lidarr from: $(LidarrPath)" Importance="high" />
  </Target>
</Project>
