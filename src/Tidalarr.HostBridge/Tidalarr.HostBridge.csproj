<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tidalarr.HostBridge</AssemblyName>
    <RootNamespace>Tidalarr</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress IDE0005 (unnecessary using) - format check runs before Lidarr assemblies are extracted,
         so types can't be resolved and usings appear unnecessary when they're actually required -->
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Lidarr.Core">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\Lidarr.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lidarr.Common">
      <HintPath>..\..\ext\Lidarr\_output\net8.0\Lidarr.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tidalarr\Tidalarr.csproj" />
  </ItemGroup>
</Project>
