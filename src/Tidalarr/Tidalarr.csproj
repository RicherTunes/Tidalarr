<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Lidarr.Plugin.Tidalarr</AssemblyName>
    <!-- Version managed by Directory.Build.props from VERSION file -->
    <!-- Suppress unused parameter warnings for interface implementations and future-proofed parameters -->
    <NoWarn>$(NoWarn);IDE0052;IDE0060</NoWarn>
    <!-- Output to bin/ root like other plugins for consistent ILRepack behavior -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <SkipHostBridge Condition="'$(SkipHostBridge)' == ''">false</SkipHostBridge>
  </PropertyGroup>

  <!-- Hostless/CI builds: exclude Lidarr-native wrappers that require Lidarr host assemblies -->
  <ItemGroup Condition="'$(SkipHostBridge)' == 'true'">
    <Compile Remove="Integration\\LidarrNative\\**\\*.cs" />
    <None Remove="Integration\\LidarrNative\\**\\*" />
  </ItemGroup>

  <!-- Dual-path Common wiring:
       - Local dev: submodule (UseInRepoCommon=true, the default)
       - CI: NuGet packages when UseNuGetPackages=true is passed
       - Override: set UseInRepoCommon explicitly to force either mode -->
  <PropertyGroup>
    <!-- CI can set UseNuGetPackages=true to use published NuGet packages -->
    <UseNuGetPackages Condition=" '$(UseNuGetPackages)' == '' ">false</UseNuGetPackages>
    <!-- Default to submodule unless CI explicitly requests NuGet packages -->
    <UseInRepoCommon Condition=" '$(UseInRepoCommon)' == '' and '$(UseNuGetPackages)' != 'true' ">true</UseInRepoCommon>
    <UseInRepoCommon Condition=" '$(UseInRepoCommon)' == '' and '$(UseNuGetPackages)' == 'true' ">false</UseInRepoCommon>
  </PropertyGroup>

  <ItemGroup Condition=" '$(UseInRepoCommon)' == 'true' ">
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj" />
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Abstractions\Lidarr.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(UseInRepoCommon)' != 'true' ">
    <!-- Use centralized versions from Directory.Packages.props -->
    <PackageReference Include="Lidarr.Plugin.Abstractions" />
    <PackageReference Include="Lidarr.Plugin.Common" />
  </ItemGroup>

  <!-- Lidarr 3.x assemblies for plugin base classes (HttpIndexerBase, DownloadClientBase) -->
  <PropertyGroup>
    <LidarrAssembliesPath>..\..\ext\Lidarr\_output\net8.0</LidarrAssembliesPath>
    <!-- Fallback paths for different assembly sources -->
    <LidarrAssembliesPath Condition="!Exists('$(LidarrAssembliesPath)\Lidarr.dll') and Exists('..\..\ext\Lidarr-docker\_output\net8.0\Lidarr.dll')">..\..\ext\Lidarr-docker\_output\net8.0</LidarrAssembliesPath>
  </PropertyGroup>

  <!-- Lidarr assembly references - Private=false prevents copying to output (provided by host) -->
  <ItemGroup Condition="'$(SkipHostBridge)' != 'true'">
    <Reference Include="Lidarr">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidarr.Core">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidarr.Common">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidarr.Http">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FluentValidation: Use Lidarr's copy to avoid AssemblyLoadContext conflicts -->
    <Reference Include="FluentValidation" Condition="Exists('$(LidarrAssembliesPath)\FluentValidation.dll')">
      <HintPath>$(LidarrAssembliesPath)\FluentValidation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NLog: Use Lidarr's copy to avoid AssemblyVersion conflicts -->
    <Reference Include="NLog" Condition="Exists('$(LidarrAssembliesPath)\NLog.dll')">
      <HintPath>$(LidarrAssembliesPath)\NLog.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Dependencies use centralized versions from Directory.Packages.props -->
  <ItemGroup>
    <!-- Only use NuGet FluentValidation when Lidarr's copy is unavailable -->
    <PackageReference Include="FluentValidation" Condition="!Exists('$(LidarrAssembliesPath)\FluentValidation.dll')" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
    <!-- Only use NuGet NLog when Lidarr's copy is unavailable -->
    <PackageReference Include="NLog" Condition="!Exists('$(LidarrAssembliesPath)\NLog.dll')" ExcludeAssets="runtime;native;contentfiles;analyzers;build;buildtransitive" />
    <!-- ILRepack for merging dependencies into single plugin DLL.
         ExcludeAssets="build" prevents NuGet's automatic target; we use PluginPackaging.targets instead.
         GeneratePathProperty="true" provides $(PkgILRepack_Lib_MSBuild_Task) for the task import. -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\plugin.json">
      <Link>plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ILRepack: Import task definition from NuGet package -->
  <UsingTask TaskName="ILRepack"
             AssemblyFile="$(PkgILRepack_Lib_MSBuild_Task)\build\ILRepack.Lib.MSBuild.Task.dll"
             Condition="'$(PkgILRepack_Lib_MSBuild_Task)' != ''" />

  <!-- Import shared plugin packaging targets from Lidarr.Plugin.Common for ILRepack merging
       Note: The submodule is still required for build targets even when using NuGet packages for code -->
  <Import Project="..\..\ext\Lidarr.Plugin.Common\build\PluginPackaging.targets"
          Condition="Exists('..\..\ext\Lidarr.Plugin.Common\build\PluginPackaging.targets')" />

  <!-- ═══════════════════════════════════════════════════════════════════════════
       PACKAGING GUARDS: Prove "no local compilation" when UseNuGetPackages=true
       ═══════════════════════════════════════════════════════════════════════════ -->

  <!-- Guard 1: Fail if UseNuGetPackages=true but UseInRepoCommon is also true (flag misconfiguration) -->
  <Target Name="ValidateNuGetPackageUsage" BeforeTargets="Build" Condition=" '$(UseNuGetPackages)' == 'true' and '$(UseInRepoCommon)' == 'true' ">
    <Error Text="BUILD ERROR: UseNuGetPackages=true but UseInRepoCommon is also true. This indicates Abstractions will be compiled from source instead of using NuGet packages. Set UseInRepoCommon=false or remove UseNuGetPackages." />
  </Target>

  <!-- Guard 2: After restore, verify no ProjectReference to ext/Lidarr.Plugin.Common exists when NuGet expected -->
  <Target Name="ValidateNoSubmoduleProjectReferences" AfterTargets="ResolveProjectReferences" Condition=" '$(UseNuGetPackages)' == 'true' ">
    <ItemGroup>
      <_SubmoduleProjectRefs Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(ProjectReference.Identity)').Contains('ext'))" />
    </ItemGroup>
    <Error Condition="'@(_SubmoduleProjectRefs)' != ''"
           Text="PACKAGING GUARD FAILED: UseNuGetPackages=true but found ProjectReference(s) to submodule: @(_SubmoduleProjectRefs). Remove ProjectReferences or set UseInRepoCommon=true." />
  </Target>

  <!-- Guard 3: After restore, verify project.assets.json contains NuGet package provenance for Abstractions -->
  <Target Name="ValidateNuGetProvenance" AfterTargets="ResolvePackageAssets" Condition=" '$(UseNuGetPackages)' == 'true' ">
    <!-- Find project.assets.json robustly (handles RuntimeIdentifier variations) -->
    <ItemGroup>
      <_CandidateAssetsFiles Include="$(MSBuildProjectDirectory)\obj\**\project.assets.json" />
    </ItemGroup>
    <PropertyGroup>
      <!-- Prefer $(ProjectAssetsFile) if set, otherwise find first match under obj/ -->
      <_AssetsJsonPath Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">$(ProjectAssetsFile)</_AssetsJsonPath>
      <_AssetsJsonPath Condition="'$(_AssetsJsonPath)' == ''">@(_CandidateAssetsFiles->First())</_AssetsJsonPath>
    </PropertyGroup>
    <Error Condition="'$(_AssetsJsonPath)' == '' or !Exists('$(_AssetsJsonPath)')"
           Text="PACKAGING GUARD FAILED: project.assets.json not found under obj/. Run 'dotnet restore' first." />
    <!-- Read assets.json and check for NuGet package entries (package IDs are lowercase in assets.json) -->
    <PropertyGroup>
      <_AssetsContent>$([System.IO.File]::ReadAllText('$(_AssetsJsonPath)'))</_AssetsContent>
      <!-- Check if assets.json contains BOTH packages in libraries section with type="package" -->
      <_HasAbstractionsNuGet>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_AssetsContent)', '"lidarr\.plugin\.abstractions/\d+\.\d+\.\d+[^"]*"\s*:\s*\{[^}]*"type"\s*:\s*"package"'))</_HasAbstractionsNuGet>
      <_HasCommonNuGet>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_AssetsContent)', '"lidarr\.plugin\.common/\d+\.\d+\.\d+[^"]*"\s*:\s*\{[^}]*"type"\s*:\s*"package"'))</_HasCommonNuGet>
    </PropertyGroup>
    <Error Condition="'$(_HasAbstractionsNuGet)' != 'True'"
           Text="PACKAGING GUARD FAILED: UseNuGetPackages=true but Lidarr.Plugin.Abstractions not found as NuGet package in project.assets.json. Ensure PackageReference exists and 'dotnet restore' was run." />
    <Error Condition="'$(_HasCommonNuGet)' != 'True'"
           Text="PACKAGING GUARD FAILED: UseNuGetPackages=true but Lidarr.Plugin.Common not found as NuGet package in project.assets.json. Ensure PackageReference exists and 'dotnet restore' was run." />
    <Message Importance="High" Text="✓ Packaging guard passed: Lidarr.Plugin.{Abstractions,Common} resolved from NuGet packages" />
  </Target>
</Project>
