<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Lidarr.Plugin.Tidalarr</AssemblyName>
    <!-- Version managed by Directory.Build.props from VERSION file -->
    <!-- Suppress unused parameter warnings for interface implementations and future-proofed parameters -->
    <NoWarn>$(NoWarn);IDE0052;IDE0060</NoWarn>
    <!-- Scope the wired Lidarr.Plugin.Analyzers to LPC0003 (the search-term HtmlEncode ban this plugin
         adopts). LPC0001 (prefer the resilience executor over raw HttpClient.SendAsync) + LPC0002 are
         separate pre-existing tech debt on the Tidal HTTP/OAuth paths — tracked, not addressed here, so
         they don't pollute this change's warning profile. LPC0003 stays active. -->
    <NoWarn>$(NoWarn);LPC0001;LPC0002</NoWarn>
    <!-- Output to bin/ root like other plugins for consistent ILRepack behavior -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Run referenced Roslyn analyzers (Lidarr.Plugin.Analyzers / LPC0003 search-term HtmlEncode ban)
         on the plugin sources. The repo default (Directory.Build.props) is false; EnableNETAnalyzers
         is left at that default so ONLY the explicit plugin analyzer runs, not the SDK's full CA set.
         There is no TreatWarningsAsErrors on this project, so LPC0001/0002 stay non-fatal warnings. -->
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SkipHostBridge default value -->
    <SkipHostBridge Condition="'$(SkipHostBridge)' == ''">false</SkipHostBridge>
    <DefineConstants Condition="'$(SkipHostBridge)' == 'true'">$(DefineConstants);SKIP_HOST_BRIDGE</DefineConstants>
  </PropertyGroup>

  <!-- SkipHostBridge diagnostic: confirm LidarrNative exclusion is working -->
  <Target Name="SkipHostBridgeDiagnostic" BeforeTargets="CoreCompile" Condition="'$(SkipHostBridge)' == 'true'">
    <Message Importance="High" Text="[SkipHostBridge] Compile items: @(Compile->Count())" />
  </Target>

  <!-- Dual-path Common wiring: submodule by default; packages when UseInRepoCommon=false -->
  <PropertyGroup>
    <UseInRepoCommon Condition=" '$(UseInRepoCommon)' == '' ">true</UseInRepoCommon>
  </PropertyGroup>

  <ItemGroup Condition=" '$(UseInRepoCommon)' == 'true' ">
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj" />
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Abstractions\Lidarr.Plugin.Abstractions.csproj" />
    <!-- LPC0003: bans HtmlEncode / Sanitize.DisplayText on search paths (the shipped "Beyoncé" 0-result
         bug class — see TidalSearchService.NormalizeSearchTerm). OutputItemType=Analyzer: consumed as a
         Roslyn analyzer, not a runtime reference; ReferenceOutputAssembly=false keeps the analyzer DLL out
         of the compile-time reference set (and the merged plugin DLL). Mirrors qobuzarr's adoption. -->
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\tools\Analyzers\Lidarr.Plugin.Analyzers\Lidarr.Plugin.Analyzers.csproj"
                      Condition="Exists('..\..\ext\Lidarr.Plugin.Common\tools\Analyzers\Lidarr.Plugin.Analyzers\Lidarr.Plugin.Analyzers.csproj')"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition=" '$(UseInRepoCommon)' != 'true' ">
    <!-- Use centralized versions from Directory.Packages.props -->
    <PackageReference Include="Lidarr.Plugin.Abstractions" />
    <PackageReference Include="Lidarr.Plugin.Common" />
  </ItemGroup>

  <!-- Lidarr 3.x assemblies for plugin base classes (HttpIndexerBase, DownloadClientBase) -->
  <PropertyGroup>
    <LidarrAssembliesPath>..\..\ext\Lidarr\_output\net8.0</LidarrAssembliesPath>
    <!-- Fallback paths for different assembly sources -->
    <LidarrAssembliesPath Condition="!Exists('$(LidarrAssembliesPath)\Lidarr.dll') and Exists('..\..\ext\Lidarr-docker\_output\net8.0\Lidarr.dll')">..\..\ext\Lidarr-docker\_output\net8.0</LidarrAssembliesPath>
  </PropertyGroup>

  <!-- Lidarr assembly references - Private=false prevents copying to output (provided by host) -->
  <ItemGroup Condition="'$(SkipHostBridge)' != 'true'">
    <Reference Include="Lidarr">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidarr.Core">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidarr.Common">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidarr.Http">
      <HintPath>$(LidarrAssembliesPath)\Lidarr.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FluentValidation: Use Lidarr's copy to avoid AssemblyLoadContext conflicts -->
    <Reference Include="FluentValidation" Condition="Exists('$(LidarrAssembliesPath)\FluentValidation.dll')">
      <HintPath>$(LidarrAssembliesPath)\FluentValidation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NLog: Use Lidarr's copy to avoid AssemblyVersion conflicts -->
    <Reference Include="NLog" Condition="Exists('$(LidarrAssembliesPath)\NLog.dll')">
      <HintPath>$(LidarrAssembliesPath)\NLog.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Dependencies use centralized versions from Directory.Packages.props -->
  <ItemGroup>
    <!-- Only use NuGet FluentValidation when Lidarr's copy is unavailable OR when SkipHostBridge excludes host refs -->
    <PackageReference Include="FluentValidation" Condition="!Exists('$(LidarrAssembliesPath)\FluentValidation.dll') OR '$(SkipHostBridge)' == 'true'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
    <!-- Use NuGet NLog when Lidarr's copy is unavailable OR when SkipHostBridge is enabled -->
    <PackageReference Include="NLog" Condition="!Exists('$(LidarrAssembliesPath)\NLog.dll') OR '$(SkipHostBridge)' == 'true'" ExcludeAssets="runtime;native;contentfiles;analyzers;build;buildtransitive" />
    <!-- ILRepack for merging dependencies into single plugin DLL.
         ExcludeAssets="build" prevents NuGet's automatic target; we use PluginPackaging.targets instead.
         GeneratePathProperty="true" provides $(PkgILRepack_Lib_MSBuild_Task) for the task import. -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\plugin.json">
      <Link>plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ILRepack: Import task definition from NuGet package -->
  <UsingTask TaskName="ILRepack"
             AssemblyFile="$(PkgILRepack_Lib_MSBuild_Task)\build\ILRepack.Lib.MSBuild.Task.dll"
             Condition="'$(PkgILRepack_Lib_MSBuild_Task)' != ''" />

  <!-- Import shared plugin packaging targets from Lidarr.Plugin.Common for ILRepack merging -->
  <Import Project="..\..\ext\Lidarr.Plugin.Common\build\PluginPackaging.targets"
          Condition="Exists('..\..\ext\Lidarr.Plugin.Common\build\PluginPackaging.targets')" />
</Project>
