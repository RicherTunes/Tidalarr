<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Lidarr.Plugin.Tidalarr</AssemblyName>
    <!-- Version managed by Directory.Build.props from VERSION file -->
    <!-- Suppress unused parameter warnings for interface implementations and future-proofed parameters -->
    <NoWarn>$(NoWarn);IDE0052;IDE0060</NoWarn>
    <!-- Disable NuGet package's built-in ILRepack target - we use PluginPackaging.targets instead -->
    <ILRepackEnabled>false</ILRepackEnabled>
  </PropertyGroup>
  <!-- Dual-path Common wiring: submodule by default; packages when UseInRepoCommon=false -->
  <PropertyGroup>
    <UseInRepoCommon Condition=" '$(UseInRepoCommon)' == '' ">true</UseInRepoCommon>
  </PropertyGroup>
  <ItemGroup Condition=" '$(UseInRepoCommon)' == 'true' ">
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj" />
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Abstractions\Lidarr.Plugin.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition=" '$(UseInRepoCommon)' != 'true' ">
    <!-- Use centralized versions from Directory.Packages.props -->
    <PackageReference Include="Lidarr.Plugin.Abstractions" />
    <PackageReference Include="Lidarr.Plugin.Common" />
  </ItemGroup>
  <!-- Dependencies use centralized versions from Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="NLog" ExcludeAssets="runtime;native;contentfiles;analyzers;build;buildtransitive" />
    <!-- ILRepack: ExcludeAssets="build" prevents the NuGet package's automatic ILRepack target from running.
         GeneratePathProperty="true" gives us $(PkgILRepack_Lib_MSBuild_Task) to import just the task DLL.
         Our PluginPackaging.targets uses the ILRepack task directly for the RepackPlugin target. -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\plugin.json">
      <Link>plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Explicitly import the ILRepack task since ExcludeAssets="build" blocks the automatic import.
       This makes the task available to PluginPackaging.targets while preventing the NuGet package's
       automatic target from running (which fails during CodeQL because Lidarr assemblies aren't available). -->
  <UsingTask TaskName="ILRepack" AssemblyFile="$(PkgILRepack_Lib_MSBuild_Task)\build\ILRepack.Lib.MSBuild.Task.dll" />

  <!-- Import shared plugin packaging targets from Lidarr.Plugin.Common -->
  <Import Project="..\..\ext\Lidarr.Plugin.Common\build\PluginPackaging.targets" Condition="Exists('..\..\ext\Lidarr.Plugin.Common\build\PluginPackaging.targets')" />
</Project>
