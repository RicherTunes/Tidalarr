<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <AssemblyName>Lidarr.Plugin.Tidalarr</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <!-- Dual-path Common wiring: submodule by default; packages when UseInRepoCommon=false -->
  <PropertyGroup>
    <UseInRepoCommon Condition=" '$(UseInRepoCommon)' == '' ">true</UseInRepoCommon>
  </PropertyGroup>
  <!-- Use in-repo submodule only -->
  <ItemGroup Condition=" '$(UseInRepoCommon)' == 'true' ">
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj" />
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\src\Abstractions\Lidarr.Plugin.Abstractions.csproj">
      <!-- Compile against Abstractions but do not copy side-by-side -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Exclude host-only adapters from plugin build to avoid Lidarr.Core dependency -->
  <ItemGroup>
    <Compile Remove="Lidarr\**\*.cs" />
  </ItemGroup>

  <Target Name="CheckCommonSubmodule" BeforeTargets="Restore" Condition=" '$(UseInRepoCommon)' == 'true' ">
    <Error Condition="!Exists('..\..\ext\Lidarr.Plugin.Common\src\Lidarr.Plugin.Common.csproj')"
           Text="Lidarr.Plugin.Common submodule is missing. Run: git submodule update --init --recursive" />
  </Target>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation" Version="9.5.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="NLog" Version="5.4.0" ExcludeAssets="runtime;native;contentfiles;analyzers;build;buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\plugin.json">
      <Link>plugin.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="..\..\ext\Lidarr.Plugin.Common\build\PluginPackaging.targets" />
</Project>
