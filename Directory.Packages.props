<Project>
  <!-- Enable Centralized Package Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Without transitive pinning, a `PackageVersion` for a package that no
         project directly references is silently ignored — meaning our
         System.Security.Cryptography.Xml 8.0.3 pin doesn't override the
         vulnerable 8.0.2 that arrives via Microsoft.IdentityModel.*. Turn it
         on so any PackageVersion entry can override transitive resolution. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Disable for Lidarr/Common submodule projects -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('ext\Lidarr')) OR $(MSBuildProjectDirectory.Contains('ext/Lidarr'))">
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- ═══════════════════════════════════════════════════════════════════════════
       PRODUCTION DEPENDENCIES
       ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="Core Framework">
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- NLog MUST match Lidarr host exactly (5.4.0, AssemblyVersion=5.0.0.0).
         Host-coupled: do NOT accept dependabot bumps for this package.
         NLog 6.x has AssemblyVersion=6.0.0.0 which conflicts with Lidarr runtime. -->
    <PackageVersion Include="NLog" Version="5.4.0" />
    <!-- FluentValidation MUST match Lidarr host AssemblyVersion (9.0.0.0). Common pins FV with PrivateAssets="all" so the version does NOT flow transitively. v9.5.4 stamps AssemblyVersion=9.0.0.0 — compatible with host. v11.x stamps 11.0.0.0 — host can NOT resolve, plugin discovery fails (see ext/Lidarr.Plugin.Common/docs/dev-guide/ALC_MULTIPLUGIN_FIX.md).
         Plugin uses Lidarr's assembly reference when available, NuGet package as fallback for CLI/test. -->
    <PackageVersion Include="FluentValidation" Version="9.5.4" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Extensions">
    <!-- All M.E.* MUST match the Lidarr host (v8.0.x). 9.0 puts AssemblyRef=9.0.0.0
         into the merged plugin DLL — at runtime the plugin loads with the host's
         8.0.0 in the default ALC and the runtime can't bridge the major version
         gap, throwing "Could not load M.E.X.Abstractions Version=9.0.0.0" during
         multi-plugin discovery. The TestKit's transitive 9.0 demand needs to be
         relaxed at the testkit side, NOT enforced upward via CPM transitive pinning
         (which propagates the runtime-incompatible version into the plugin DLL). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <!-- System.Text.Json 8.x for .NET 8 runtime compatibility -->
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />
    <!-- 8.0.2 has GHSA-37gx-xxp4-5rgx + GHSA-w3x6-4m5h-cxqf (High). Force 8.0.3+
         to clear the Security Audit gate; arrives transitively via Microsoft.IdentityModel. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup Label="Shared Plugin Ecosystem">
    <PackageVersion Include="Lidarr.Plugin.Abstractions" Version="1.2.2" />
    <PackageVersion Include="Lidarr.Plugin.Common" Version="1.2.2" />
  </ItemGroup>
  <!-- ═══════════════════════════════════════════════════════════════════════════
       TEST DEPENDENCIES
       ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="Test Framework">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="Assertions and Mocking">
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
  <!-- ═══════════════════════════════════════════════════════════════════════════
       BUILD TOOLS
       ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup Label="Build Tools">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <!-- ILRepack for merging plugin dependencies into single DLL -->
    <PackageVersion Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" />
  </ItemGroup>
</Project>
